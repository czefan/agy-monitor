{
  "name": "agy-monitor",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs --clean && tsc && node scripts/build.mjs --assemble",
    "test": "pnpm build && node --test tests/telemetry.test.mjs",
    "sync": "pnpm build && node scripts/sync.mjs",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
